{
    "presets": {
        "Clear and Run": {
            "description": "清除并运行采集 -- clean and run",
            "commands": [
                "*CLS",
                ":ACQuire:CDISplay",
                ":ACQ:RUN",
                "*OPC?"
            ],
            "repeat": 1,
            "interval": 1.0
        },
        "Measurement Setup": {
            "description": "测量设置 -- measurement setup",
            "commands": [
                ":MEASure:SOURce CH1",
                ":MEASure:VPP?",
                ":MEASure:VRMS?",
                ":MEASure:FREQuency?"
            ],
            "repeat": 3,
            "interval": 0.8
        },
        "查询目标温度": {
            "description": "查询釆保和FPGA目标温度",
            "commands": [
                ":SYSTem:INSTrument:FAN:AUTO:TARGet:FPGA?",
                ":SYSTem:INSTrument:FAN:AUTO:TARGet:TH?"
            ],
            "repeat": 1,
            "interval": 1.0
        },
        "查询型号": {
            "description": "查询机器型号、PN、SN",
            "commands": [
                "*IDN?"
            ],
            "repeat": 1,
            "interval": 0.5
        }
    }
}